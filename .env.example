# Spotify app (https://developer.spotify.com/dashboard → your app → Settings)
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here   # server only; never prefix with VITE_

# Owner tools (#admin) — any long random string
ADMIN_KEY=change-me

# Optional: hard-code the group playlist instead of setting it in #admin
# GROUP_PLAYLIST_ID=

# Production storage (Vercel → Storage → Upstash Redis sets these automatically).
# Local `npm run dev` uses an in-memory store instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional. Defaults to the site's origin + "/". Must match a Spotify Redirect URI exactly.
# VITE_REDIRECT_URI=https://your-domain.com/
